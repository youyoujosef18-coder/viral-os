# ============================================================================
# VIRAL OS environment configuration. Copy to .env (local) or set in your host.
# Every third-party integration is optional: without it, the related feature
# shows exact setup instructions instead of fake data.
# ============================================================================

# --- Core (required) --------------------------------------------------------
NODE_ENV=development
# Public base URL. Must be https in production; OAuth redirect URIs derive from it.
APP_URL=http://localhost:3000
# Postgres. For Supabase use the pooler URL (port 6543) and set DATABASE_POOLER=true.
DATABASE_URL=postgres://postgres@127.0.0.1:5432/viral_os
DATABASE_POOLER=
# 32+ random characters: openssl rand -base64 32
SESSION_SECRET=
# Exactly 32 bytes, base64: openssl rand -base64 32  (encrypts OAuth tokens at rest)
TOKEN_ENCRYPTION_KEY=

# --- Queue / worker ---------------------------------------------------------
# Redis for BullMQ (set maxmemory-policy=noeviction). Worker: npm run worker
REDIS_URL=redis://127.0.0.1:6379

# --- Auth -------------------------------------------------------------------
# "supabase" (recommended for production) or "local" (email+password in Postgres)
AUTH_PROVIDER=local
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: a header your host sets with the real client IP that clients can't forge (e.g. x-real-ip behind
# nginx). Used for login/sign-up rate limits. Default: the last X-Forwarded-For hop (correct on Vercel).
TRUSTED_IP_HEADER=

# --- Storage ----------------------------------------------------------------
# "local" (disk, dev only) or "supabase" (private bucket; direct browser uploads)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./.storage
SUPABASE_STORAGE_BUCKET=media

# --- AI ---------------------------------------------------------------------
# "anthropic", "openai" or "none". ("mock" is test-only and rejected by diagnose.)
AI_PROVIDER=none
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5-mini
# Thumbnail image generation (optional): "openai" or "none"
IMAGE_PROVIDER=none
OPENAI_IMAGE_MODEL=gpt-image-1

# --- YouTube ----------------------------------------------------------------
# OAuth client (Web application). Redirect URI: ${APP_URL}/api/oauth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API key restricted to YouTube Data API v3 (Trend Radar, keywords, competitors, Clip Studio YouTube links)
YOUTUBE_API_KEY=
# "true" adds the youtube.force-ssl scope so Clip Studio can read caption tracks of your own videos.
# It is a sensitive scope: Google shows a stronger consent screen and requires app verification for public use.
YOUTUBE_CAPTION_ACCESS=
# Testing only: send YouTube Data / Analytics API calls to a mock server (see tests/e2e/mock-youtube.mjs).
YOUTUBE_API_BASE_URL=
YOUTUBE_ANALYTICS_BASE_URL=

# --- TikTok -----------------------------------------------------------------
# Redirect URI: ${APP_URL}/api/oauth/tiktok/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Instagram (Instagram API with Instagram Login) -------------------------
# Redirect URI: ${APP_URL}/api/oauth/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v25.0

# --- Tools ------------------------------------------------------------------
# Optional explicit paths for measured video analysis
FFMPEG_PATH=
FFPROBE_PATH=
OPENAI_TRANSCRIBE_MODEL=whisper-1
